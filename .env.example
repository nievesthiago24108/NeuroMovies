# =============================================================================
# TMDB API configuration
# =============================================================================

# API Read Access Token (obligatorio).
# Cómo obtenerlo:
#   1. Creá una cuenta gratuita en https://www.themoviedb.org/signup
#   2. Andá a https://www.themoviedb.org/settings/api
#   3. Click en "Create" / "API Key" (tipo "User" o la v3)
#   4. Copiá el "API Read Access Token" (es un JWT que empieza con "eyJ...")
#   5. Pegalo acá sin comillas:
TMDB_ACCESS_TOKEN=

# Idioma de TMDB para títulos, sinopsis y demás.
# Valores posibles: es-MX (por defecto), es-AR, es-ES, es-CO, en-US, etc.
# Si un título o sinopsis viene vacío en este idioma, se usará en-US como respaldo.
TMDB_LANGUAGE=es-MX

# =============================================================================
# Base de datos (PostgreSQL)
# =============================================================================

# Cadena de conexión de PostgreSQL. Es obligatoria.
# En Vercel/Neon la integración la inyecta como DATABASE_URL o POSTGRES_URL.
# Local: podés usar la misma base de Neon, o un Postgres local:
#   postgresql://usuario:clave@localhost:5432/mi_catalogo
# Si usás el pooler de Neon para serverless, incluí el sufijo "-pooler".
DATABASE_URL=

# Conexión directa de Neon (sin "-pooler"). Es opcional en desarrollo; la usan
# las migraciones (`npm run db:migrate`) y la importación (`db:import-sqlite`),
# que no deberían pasar por el pooler de transacciones.
DATABASE_URL_UNPOOLED=

# =============================================================================
# Inicio de sesión (opcional)
# =============================================================================

# Contraseña para entrar a la app. Si la dejás vacía, no se pide login
# (cómodo para desarrollo, NO recomendado en la web).
APP_PASSWORD=

# Secreto para firmar la cookie de sesión. Si no lo definís, se usa APP_PASSWORD.
# Podés generar uno con: openssl rand -base64 32
AUTH_SECRET=